{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaierSpeedTest",
  "version": "1.0.0",
  "identifier": "com.taierspeed.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TaierSpeedTest",
        "width": 440,
        "height": 634,
        "minWidth": 390,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
